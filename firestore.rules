rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // This rule allows anyone with your Firestore database reference to view, edit,
    // and delete all data in your Firestore database. It is useful for getting
    // started, but it is configured to expire after 30 days because it
    // leaves your app open to attackers. At that time, all client
    // requests to your Firestore database will be denied.
    //
    // Make sure to write security rules for your app before that time, or else
    // all client requests to your Firestore database will be denied until you Update
    // your rules
    match /{document=**} {
      allow read, write: if request.time < timestamp.date(2025, 9, 20);
    }
    
    // Templates collection - matches the actual structure: templates/avatars/avatars/{avatarId}
    match /templates/avatars/avatars/{avatarId} {
      // Public templates: Read access for all authenticated users
      allow read: if request.auth != null;
      
      // Private templates: Read/write access only for owner
      allow write: if request.auth != null && 
                   (resource.data.user_id == request.auth.uid || 
                    resource.data.user_id == null); // System avatars
    }

    // Voice templates collection - matches the structure: templates/voices/voices/{voiceId}
    match /templates/voices/voices/{voiceId} {
      // Public voice templates: Read access for all authenticated users
      allow read: if request.auth != null;
      
      // Voice templates are managed by admin only - no client write access
      allow write: if false; // Admin only via server-side scripts
    }

    // Voice categories collection - matches the structure: templates/voices/categories/{categoryId}
match /templates/voices/categories/{categoryId} {
  // Public voice categories: Read access for all authenticated users
  allow read: if request.auth != null;

  // Voice categories are managed by admin only - no client write access
  allow write: if false; // Admin only via server-side scripts
}

// User voice favorites collection
match /user_voice_favorites/{favoriteId} {
  // Users can read and write their own favorites
  allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
  allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
}

// Voice usage tracking collection
match /voice_usage/{usageId} {
  // Users can create their own usage records
  allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
  
  // Read access for analytics (admin only in production)
  allow read: if request.auth != null;
}

// Voice statistics collection
match /voice_stats/{voiceId} {
  // Read access for analytics
  allow read: if request.auth != null;
  
  // Write access for analytics updates (admin only)
  allow write: if request.auth != null;
}
  }
} 